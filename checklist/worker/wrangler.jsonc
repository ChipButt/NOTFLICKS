{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "show-checklist-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-18",
  "vars": {
    "GITHUB_OWNER": "ChipButt",
    "GITHUB_REPO": "NOTFLICKS",
    "GITHUB_BRANCH": "main",
    "STATE_PATH": "checklist/data/checklist.json",
    "ASSET_PREFIX": "checklist/assets",
    "MAX_ASSET_BYTES": "20971520",
    "ALLOWED_ORIGINS": "https://chipbutt.github.io"
  }
}
